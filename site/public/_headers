# Where an agent that lands on the homepage finds the machine-readable side
# of forkable.dev (RFC 8288 Link headers, the relations withone.ai uses plus
# the agent skill index). The files themselves are written by
# scripts/agent-files.mjs at build time. Rules must not overlap: Cloudflare
# joins the values of every rule that matches.
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown", </.well-known/agent-skills/index.json>; rel="agent-skills"; type="application/json", </templates.json>; rel="alternate"; type="application/json", </.well-known/ai-catalog.json>; rel="ai-catalog"

/contribute
  Link: </contribute.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"

/contribute/
  Link: </contribute.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"

/mcp
  Link: </mcp.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"

/mcp/
  Link: </mcp.md>; rel="alternate"; type="text/markdown", </llms.txt>; rel="describedby"; type="text/plain"

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/templates.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/*.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/site.webmanifest
  Content-Type: application/manifest+json

/og.png
  Cache-Control: public, max-age=3600

{
  "name": "forkable-components",
  "version": "0.0.1",
  "private": true,
  "description": "Prototype: Forkable components. UI, server route and grant together, added to a fork with one command.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm registry && concurrently -k -n api,ui \"tsx watch --clear-screen=false server/dev.ts\" \"vite\"",
    "dev:api": "tsx watch --clear-screen=false server/dev.ts",
    "dev:ui": "vite",
    "registry": "tsx scripts/build-registry.ts",
    "build": "pnpm registry && BLOCKS_BASE=/blocks/ VITE_BROWSER_API=1 vite build",
    "forkable": "node package/bin/forkable.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@hono/node-server": "^1.14.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@withone/connect": "^0.18.0",
    "clsx": "^2.1.1",
    "dev": "^0.1.5",
    "hono": "^4.7.0",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0"
  }
}

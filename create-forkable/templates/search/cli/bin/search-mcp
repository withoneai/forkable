#!/bin/sh
# Starts `search mcp`, the stdio bridge to a running Search, for agents that run
# local MCP servers (Claude Code, Cursor, Claude Desktop). Agents start it with a
# short PATH, so this looks for a Node.js 22 or newer each time it runs instead of
# keeping one node's path in the agent's settings: SEARCH_NODE, then PATH, then
# the usual install places. Every argument goes to `search mcp`.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for cand in "$SEARCH_NODE" "$(command -v node 2>/dev/null)" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node \
  "$HOME/.volta/bin/node" "$HOME/.local/share/fnm/aliases/default/bin/node" "$HOME/.nvm/current/bin/node"; do
  [ -n "$cand" ] || continue
  if [ -x "$cand" ]; then
    major=$("$cand" -e 'process.stdout.write(process.versions.node.split(".")[0])' 2>/dev/null) || continue
    if [ "$major" -ge 22 ] 2>/dev/null; then exec "$cand" "$dir/search.mjs" mcp "$@"; fi
  fi
done
for cand in "$HOME"/.nvm/versions/node/v*/bin/node; do
  [ -x "$cand" ] || continue
  major=$("$cand" -e 'process.stdout.write(process.versions.node.split(".")[0])' 2>/dev/null) || continue
  if [ "$major" -ge 22 ] 2>/dev/null; then exec "$cand" "$dir/search.mjs" mcp "$@"; fi
done
echo "[search mcp] Node.js 22 or newer was not found. Install it from nodejs.org (or set SEARCH_NODE to its path), then restart this agent." >&2
exit 1

# Connect app ids. `pnpm connect` writes these for you.
# The client secret and the Connect key never go in this file:
# paste them on http://localhost:52289/setup/connect (Keychain or ~/.search/connect.env).
ONE_CLIENT_ID=
ONE_PERMISSION_SET=
ONE_REDIRECT_URI=http://localhost:52289/api/one/callback

# Optional: an external Postgres (Supabase session pooler or direct, port 5432).
# Unset means the embedded Postgres in ~/.search/db on port 55441.
# SEARCH_DATABASE_URL=postgres://user:pass@host:5432/search

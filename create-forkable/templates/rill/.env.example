# Rill runs with no keys at all: `pnpm start` triages the Acme sample inbox.
# Everything below is optional.

# --- One Connect (sign in with One; the only login) --------------------------
# Create the app in the One dashboard: Developers -> Connect -> New app.
# Easier and safer: paste these at http://localhost:5180/setup/connect, which
# keeps them in your macOS Keychain. Once a client ID is saved there, the
# values below are ignored.
# Register the redirect URI exactly as below (local mode pins port 51789).
ONE_CLIENT_ID=
ONE_CLIENT_SECRET=
ONE_CONNECT_KEY=
ONE_REDIRECT_URI=http://localhost:51789/api/one/callback
ONE_PERMISSION_SET=

# --- Jev and the writer -------------------------------------------------------
# No platform secret lives in this file. Jev (TypeSafe) and any model through One
# run on the signed-in user's Connect grant, like Gmail. A user who has not
# granted TypeSafe gets the writer answering Jev's questions, with Check badges.

# --- Writer engine -------------------------------------------------------------
# local | one | connect. Default: local when a signed-in CLI is found, else one.
AI_ENGINE=
AI_PROVIDER=anthropic
AI_MODEL=
JEV_MODEL=jev-latest

# --- Server --------------------------------------------------------------------
RILL_PORT=51789
RILL_HOME=~/.rill
DATABASE_URL=

      "platforms": ["gmail", "google-calendar", "outlook-mail", "outlook-calendar", "zoom", "anthropic", "typesafe"],
      "packageManager": "pnpm",
      "create": "npm create forkable@latest my-inbox -- --template rill",
      "demo": "pnpm start",
      "site": "https://rill.forkable.dev",

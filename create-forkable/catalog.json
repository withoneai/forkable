{
  "version": 1,
  "site": "https://forkable.dev",
  "command": "npm create forkable@latest <dir> -- --template <id>",
  "agentCommand": "npm create forkable@latest <dir> -- --template <id> --json --yes",
  "templates": [
    {
      "id": "forkable-starter",
      "name": "Forkable starter",
      "status": "available",
      "kind": "Starter",
      "tagline": "Fork a business. The team comes with it.",
      "description": "The base every Forkable business starts from: One Connect and Sign in with One prewired, a keyless Acme Inc demo, agents/, AGENTS.md, build skills and a gtm/ kit.",
      "platforms": ["gmail"],
      "packageManager": "npm",
      "create": "npm create forkable@latest my-business",
      "demo": "npm start",
      "site": "https://forkable.dev",
      "code": "https://github.com/withoneai/forkable/tree/main/create-forkable/templates/forkable-starter",
      "repo": null,
      "envToGoLive": ["ONE_CLIENT_ID", "ONE_CLIENT_SECRET", "ONE_CONNECT_KEY", "ONE_REDIRECT_URI"]
    },
    {
      "id": "rill",
      "name": "Rill",
      "status": "available",
      "kind": "Email",
      "tagline": "Your goals and your VIPs decide what you see first.",
